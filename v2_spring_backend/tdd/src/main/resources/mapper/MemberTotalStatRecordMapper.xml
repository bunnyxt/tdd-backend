<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bunnyxt.tdd.dao.MemberTotalStatRecordDao">
    <resultMap id="BaseResultMap" type="com.bunnyxt.tdd.model.MemberTotalStatRecord">
        <result column="id" property="id" />
        <result column="added" property="added" />
        <result column="mid" property="mid" />
        <result column="video_count" property="video_count" />
        <result column="view" property="view" />
        <result column="danmaku" property="danmaku" />
        <result column="reply" property="reply" />
        <result column="favorite" property="favorite" />
        <result column="coin" property="coin" />
        <result column="share" property="share" />
        <result column="like" property="like" />
    </resultMap>

    <sql id="BaseColumnList">
        id, extract(epoch from added)::bigint as added, mid, video_count, "view", danmaku, reply, favorite, coin, share, "like"
    </sql>

    <select id="queryMemberTotalStatRecords" resultMap="BaseResultMap">
        select <include refid="BaseColumnList" />
        from tdd_member_total_stat_record
        where mid = #{mid}
        <if test="start_ts > 0">
            <choose>
                <when test="start_ts > @com.bunnyxt.tdd.util.EpochSeconds@MAX_FINITE_SECOND">and false</when>
                <otherwise>and added >= #{start_ts,typeHandler=com.bunnyxt.tdd.typehandler.EpochSecondTypeHandler}</otherwise>
            </choose>
        </if>
        <if test="end_ts > 0 and end_ts &lt;= @com.bunnyxt.tdd.util.EpochSeconds@MAX_FINITE_SECOND">
            and added &lt;= #{end_ts,typeHandler=com.bunnyxt.tdd.typehandler.EpochSecondTypeHandler}
        </if>
        order by tdd_member_total_stat_record.added desc
        <choose>
            <when test="last_count != null and last_count > 0">limit #{last_count}</when>
            <otherwise>limit #{ps} offset #{offset}</otherwise>
        </choose>
    </select>

    <select id="queryMemberTotalStatRecordsCount" resultType="Long">
        select
        count(1)
        from
        tdd_member_total_stat_record
        <where>
            <if test="mid > 0">
                and mid = #{mid}
            </if>
            <if test="start_ts > 0">
                <choose>
                    <when test="start_ts > @com.bunnyxt.tdd.util.EpochSeconds@MAX_FINITE_SECOND">and false</when>
                    <otherwise>and added >= #{start_ts,typeHandler=com.bunnyxt.tdd.typehandler.EpochSecondTypeHandler}</otherwise>
                </choose>
            </if>
            <if test="end_ts > 0 and end_ts &lt;= @com.bunnyxt.tdd.util.EpochSeconds@MAX_FINITE_SECOND">
                and added &lt;= #{end_ts,typeHandler=com.bunnyxt.tdd.typehandler.EpochSecondTypeHandler}
            </if>
        </where>
    </select>

</mapper>